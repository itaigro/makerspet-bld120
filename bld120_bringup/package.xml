<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bld120_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the Maker's Pet BLD-120MM robot, layered on top of the Kaia.ai platform.</description>
  <maintainer email="itaigro@gmail.com">Itaigro</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kaiaai_bringup</exec_depend>
  <exec_depend>makerspet_mini</exec_depend>
  <exec_depend>bld120_sim</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
