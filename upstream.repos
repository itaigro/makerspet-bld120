    url: https://github.com/kaiaai/m-explore-ros2.git
    version: 9279196223699bf407f5ca7617d411c969aec2d1
  # Not used by the BLD-120MM, but declared as exec_depend by kaiaai_bringup.
  makerspet_loki:
    type: git
    url: https://github.com/makerspet/makerspet_loki.git
    version: e778ecde98b4f0dc2dcb32d25f43cb4cb4af1158
  makerspet_snoopy:
